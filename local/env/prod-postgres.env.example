# Copy to prod-postgres.env (git-ignored), choose a password, then:  local/up.sh prod-postgres
# Votes go to PostgreSQL; Redis still runs, for node heartbeats.
PODPOLL_ENV=prod
FRONTEND_PORT=8082
API_VERSION=1.0
FRONTEND_VERSION=1.0
API_REPLICAS=3
COMPOSE_PROFILES=postgres
DB_HOST=postgres
DB_PASSWORD=
