# local/up.sh ecs-sim  ->  http://localhost:8083
# "ECS mode" without AWS: a fake task metadata endpoint makes every API replica look like a
# Fargate task (task ID as identity, AZ / launch type as its "node"; RBAC card hidden).
PODPOLL_ENV=dev
FRONTEND_PORT=8083
API_VERSION=2.0
FRONTEND_VERSION=2.0
API_REPLICAS=2
COMPOSE_PROFILES=ecs-sim
PLATFORM=ecs
ECS_CONTAINER_METADATA_URI_V4=http://ecs-metadata:8080/v4/podpoll-sim
# Empty on purpose: names come from the task metadata, like on Fargate.
NODE_NAME=
# The Fargate sidecar reads its own micro-VM's /proc, not a mounted host /proc.
AGENT_HOST_PROC=/proc
